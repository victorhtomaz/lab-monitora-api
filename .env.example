# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORT=8080

# Database Connection
ConnectionStrings__DefaultConnection=""

# JWT Settings
Settings__Jwt__SigningKey=wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww
Settings__Jwt__ExpirationTimeInMinutes=15

# InfluxDB Settings
Settings__InfluxDB__Url=http://influxdb:8086
Settings__InfluxDB__Organization=MonitoraAgro
Settings__InfluxDB__Bucket=testes

# Firebase Settings
Settings__Firebase__ProjectId=
Settings__Firebase__CredentialFilePath=/app/firebase-credentials.json

# InfluxDB Container Setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin123
DOCKER_INFLUXDB_INIT_ORG=MonitoraAgro
DOCKER_INFLUXDB_INIT_BUCKET=testes
DOCKER_INFLUXDB_INIT_MODE=setup
INFLUXDB_ADMIN_TOKEN=
